# Postgres
POSTGRES_USER=elearning
POSTGRES_PASSWORD=elearning
POSTGRES_DB=elearning
POSTGRES_PORT=5432

# API
API_PORT=8000
APP_DATABASE_URL=postgresql+asyncpg://elearning:elearning@postgres:5432/elearning
# Chemin hôte monté dans le conteneur sur /app/videos
VIDEOS_HOST_PATH=./e-learning-api/videos
APP_DEBUG=false
APP_INIT_DB=false
APP_RECONCILE_ON_STARTUP=false
APP_LOG_LEVEL=INFO
# Liste explicite obligatoire : "*" est refusé (cookies d'authentification)
APP_CORS_ORIGINS=["http://localhost:3000"]
# Authentification — valeurs d'exemple, refusées au démarrage hors APP_DEBUG=true.
# APP_SECRET_KEY : au moins 32 caractères (ex. `openssl rand -hex 32`).
APP_SECRET_KEY=changethis
# 10080 min = 7 jours
APP_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Premier admin, créé au démarrage s'il n'existe pas (mot de passe jamais réécrit ensuite)
APP_FIRST_ADMIN_EMAIL=admin@example.com
APP_FIRST_ADMIN_PASSWORD=changethis
# Anti-bruteforce : N échecs de connexion par email ou par IP sur la fenêtre → 429
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_WINDOW_MINUTES=15
# Hôtes où le cookie de session n'est pas `Secure` en HTTP (le token circule alors en clair).
# Ajouter l'IP d'un serveur LAN sans HTTPS, ex. ["localhost","127.0.0.1","::1","192.168.1.19"]
APP_INSECURE_COOKIE_HOSTS=["localhost","127.0.0.1","::1"]
# Chat (résumé + ask) — endpoint OpenAI-compatible /v1
APP_OPENAI_BASE_URL=http://host.docker.internal:1234/v1
APP_OPENAI_API_KEY=lm-studio
APP_OPENAI_MODEL=openapi/gpt-oss-20b
APP_MAX_UPLOAD_SIZE=524288000
# RAG — embeddings : laisser APP_EMBEDDING_BASE_URL vide = sentence-transformers local
QDRANT_PORT=6333
APP_QDRANT_URL=http://qdrant:6333
# APP_EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
# APP_EMBEDDING_API_KEY=lm-studio
APP_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
APP_EMBEDDING_DIMS=384
APP_RAG_TOP_K=6
APP_RAG_CHUNK_SIZE=800
APP_RAG_CHUNK_OVERLAP=120

# RabbitMQ (jobs de calcul)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
APP_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
APP_RABBITMQ_EXCHANGE=elearning_jobs
APP_WORKER_PREFETCH=3

# Front
FRONT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
